# Copy this file to .env for local development.
# Never commit a real Cesium token.
CESIUM_ION_TOKEN=CESIUM ION KEY HERE
CESIUM_IMAGERY_ASSET_ID=
CESIUM_TERRAIN_ASSET_ID=
SKYSCAPE_CACHE_DIR=.cache/skyscape
SKYSCAPE_BUILD_DIR=build
MSFS_SDK_PATH=C:\MSFS 2024 SDK
MSFS_PACKAGE_TOOL=C:\MSFS 2024 SDK\Tools\bin\fspackagetool.exe
SKYSCAPE_WORKERS=4
SKYSCAPE_HTTP_TIMEOUT=60
